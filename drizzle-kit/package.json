{
	"name": "drizzle-kit",
	"version": "1.0.0-rc.5",
	"type": "module",
	"homepage": "https://orm.drizzle.team",
	"keywords": [
		"drizzle",
		"orm",
		"pg",
		"mysql",
		"singlestore",
		"postgresql",
		"postgres",
		"sqlite",
		"database",
		"sql",
		"typescript",
		"ts",
		"drizzle-kit",
		"migrations",
		"schema",
		"tanstack-intent",
		"skills",
		"agent-skills"
	],
	"publishConfig": {
		"provenance": true
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/drizzle-team/drizzle-orm.git"
	},
	"author": "Drizzle Team",
	"license": "MIT",
	"bin": {
		"drizzle-kit": "./bin.js"
	},
	"engines": {
		"node": "^20.19.0 || >=22.12.0"
	},
	"scripts": {
		"api": "tsx ./dev/api.ts",
		"migrate:old": "drizzle-kit generate:mysql",
		"cli": "tsx ./src/cli/index.ts",
		"test": "TEST_CONFIG_PATH_PREFIX=./tests/cli/ vitest run",
		"test:types": "tsc7 -p ./tsconfig.typetest.json",
		"build": "bun --bun run scripts/build.ts",
		"build:artifact": "pnpm run build",
		"pack": "cp package.json README.md dist/ && (cd dist && npm pack --pack-destination ..) && rm -f package.tgz && mv *.tgz package.tgz",
		"pack:artifact": "pnpm run pack",
		"publish": "npm publish package.tgz",
		"test:postgres": "vitest run ./postgres/",
		"test:other": "vitest run ./mysql/ ./sqlite/ ./other",
		"test:cockroach": "vitest run ./cockroach",
		"test:mssql": "vitest run ./mssql",
		"test:singlestore": "vitest run ./singlestore",
		"skills:revision:check": "tsx scripts/check-skills-revision.ts"
	},
	"peerDependencies": {
		"drizzle-orm": ">=1.0.0-rc.5",
		"oxc-parser": "^0.157.0"
	},
	"peerDependenciesMeta": {
		"drizzle-orm": {
			"optional": true
		},
		"oxc-parser": {
			"optional": true
		}
	},
	"devDependencies": {
		"@aws-sdk/client-rds-data": "^3.556.0",
		"@aws/aurora-dsql-node-postgres-connector": "^0.1.9",
		"@aws/aurora-dsql-postgresjs-connector": "^0.3.1",
		"@cloudflare/workers-types": "^4.20230518.0",
		"@drizzle-team/brocli": "0.12.1",
		"@drizzle/test-utils": "workspace:*",
		"@duckdb/node-api": "1.5.0-r.1",
		"@effect/sql": "^0.48.5",
		"@electric-sql/pglite": "^0.5.15",
		"@electric-sql/pglite-pgvector": "^0.0.16",
		"@hono/node-server": "^1.9.0",
		"@hono/zod-validator": "^0.2.1",
		"@js-temporal/polyfill": "^0.5.1",
		"@libsql/client": "^0.10.0",
		"@modelcontextprotocol/sdk": "^1.29.0",
		"@neondatabase/serverless": "^1.0.2",
		"@originjs/vite-plugin-commonjs": "^1.0.3",
		"@planetscale/database": "^1.19.0",
		"@sqlitecloud/drivers": "^1.0.653",
		"@tursodatabase/database": "0.7.1",
		"@tursodatabase/serverless": "^1.4.0",
		"@types/better-sqlite3": "^9.6.0",
		"@types/bun": "^1.4.4",
		"@types/dockerode": "^3.3.28",
		"@types/glob": "^8.1.0",
		"@types/json-diff": "^1.0.3",
		"@types/micromatch": "^4.0.9",
		"@types/minimatch": "^5.1.2",
		"@types/mssql": "^9.1.11",
		"@types/node": "^24.7.2",
		"@types/pg": "^8.10.7",
		"@types/pluralize": "^0.0.33",
		"@types/semver": "^7.5.5",
		"@types/uuid": "^9.0.8",
		"@types/ws": "^8.5.10",
		"@vercel/postgres": "^0.8.0",
		"ava": "^5.1.0",
		"better-sqlite3": "^13.0.3",
		"bun-types": "^1.4.4",
		"camelcase": "^7.0.1",
		"chalk": "^5.2.0",
		"commander": "^12.1.0",
		"dockerode": "^4.0.6",
		"dotenv": "^16.0.3",
		"drizzle-orm": "workspace:./drizzle-orm/dist",
		"env-paths": "^3.0.0",
		"get-port": "^6.1.2",
		"glob": "^8.1.0",
		"hanji": "^0.0.8",
		"hono": "^4.7.9",
		"jiti": "^2.7.0",
		"json-diff": "1.0.6",
		"micromatch": "^4.0.8",
		"minimatch": "^7.4.3",
		"mssql": "^12.0.0",
		"mysql2": "3.14.1",
		"node-fetch": "^3.3.2",
		"ohm-js": "^17.1.0",
		"orm044": "npm:drizzle-orm@0.44.1",
		"oxc-parser": "^0.157.0",
		"pg": "^8.11.5",
		"pluralize": "^8.0.0",
		"postgres": "^4.1.1",
		"prettier": "^3.5.3",
		"semver": "^7.7.2",
		"tsx": "^4.20.6",
		"typescript": "6.0.3",
		"uuid": "^9.0.1",
		"ws": "^8.18.2",
		"zod": "^3.25",
		"zx": "^8.8.5"
	},
	"exports": {
		".": {
			"types": "./index.d.ts",
			"default": "./index.js"
		},
		"./cli": {
			"types": "./cli.d.ts",
			"default": "./cli.js"
		},
		"./api-*": {
			"types": "./api-*.d.ts",
			"default": "./api-*.js"
		},
		"./payload/*": {
			"types": "./payload/*.d.ts",
			"default": "./payload/*.js"
		}
	}
}
